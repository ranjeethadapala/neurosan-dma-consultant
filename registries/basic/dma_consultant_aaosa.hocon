# The schema specifications for this file are documented here:
# https://github.com/cognizant-ai-lab/neuro-san/blob/main/docs/agent_hocon_reference.md

{
    include "registries/aaosa.hocon",
    include "registries/expertise_scoping_instructions.hocon",
    include "config/llm_config.hocon",

    "metadata": {
        "description": "DMA Multi-Agent Analytics Consultant using AAOSA",
        "tags": ["DMA", "AAOSA", "Adobe", "GA4", "Analytics"],
        "sample_queries": [
            "Conversion rate dropped from 3.5% to 2.8%. Analyze possible reasons.",
            "Traffic increased by 30% but revenue stayed flat.",
            "Bounce rate increased from 40% to 70%.",
            "How should we improve checkout conversion?"
        ]
    },

    "tools": [

        {
            "name": "DMA_Consultant",

            "function": {
                "description": "DMA Consulting Lead",

                "parameters": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "DMA business problem requiring analysis"
                        }
                    },
                    "required": ["query"]
                }
            },

            "instructions": """
You are a DMA Consulting Lead.

Your role is to coordinate specialist agents.

Always consult:

1. Analytics_Agent
2. Tracking_Agent
3. CRO_Agent
4. Recommendation_Agent

Do not ask the user for additional information unless absolutely necessary.

Make reasonable assumptions when information is missing.

Clearly state assumptions.

Never stop at gathering information.

Generate a complete DMA consulting response.

Only provide the final consolidated report.
""" ${expertise_scoping_instructions} ${aaosa_instructions},

            "tools": [
                "Analytics_Agent",
                "Tracking_Agent",
                "CRO_Agent",
                "Recommendation_Agent"
            ]
        },

        {
            "name": "Analytics_Agent",

            "function": ${aaosa_call}{
                "description": """
Adobe Analytics and GA4 specialist
"""
            },

            "instructions": """
You are a Digital Analytics specialist.

Expertise:

- Adobe Analytics
- GA4
- Attribution
- Funnels
- Segmentation
- Conversion Analysis
- Customer Journey Analysis
- KPI Analysis

Analyze from an analytics perspective.

Assume standard ecommerce implementation unless stated otherwise.

If information is missing:

- Make reasonable assumptions
- Provide likely root causes
- Do not ask follow-up questions
- Clearly state assumptions

Always provide:

Analytics Findings

Potential Root Causes

KPIs To Review

Likely Business Impact

Return findings only.
""" ${aaosa_instructions}
        },

        {
            "name": "Tracking_Agent",

            "function": ${aaosa_call}{
                "description": """
Analytics implementation specialist
"""
            },

            "instructions": """
You are a Digital Analytics Implementation specialist.

Expertise:

- GTM
- Adobe Launch
- Data Layer
- Events
- eVars
- Props
- GA4 Events
- Tag Management

Analyze from an implementation perspective.

Assume standard Adobe Analytics, GA4, GTM and Adobe Launch implementations.

If information is missing:

- Make reasonable assumptions
- Suggest likely tracking issues
- Suggest validation steps
- Do not ask follow-up questions

Always provide:

Tracking Findings

Potential Tracking Issues

Validation Steps

Potential Impact

Return findings only.
""" ${aaosa_instructions}
        },

        {
            "name": "CRO_Agent",

            "function": ${aaosa_call}{
                "description": """
Conversion Rate Optimization specialist
"""
            },

            "instructions": """
You are a Conversion Optimization specialist.

Expertise:

- UX
- CRO
- A/B Testing
- Experimentation
- Landing Pages
- Checkout Optimization
- Personalization

Analyze from an optimization perspective.

Assume standard ecommerce journeys.

If information is missing:

- Make reasonable assumptions
- Identify likely funnel issues
- Identify possible UX friction
- Do not ask follow-up questions

Always provide:

Optimization Findings

User Experience Risks

Optimization Opportunities

Potential Impact

Return findings only.
""" ${aaosa_instructions}
        },

        {
            "name": "Recommendation_Agent",

            "function": ${aaosa_call}{
                "description": """
DMA Principal Consultant
"""
            },

            "instructions": """
You are a DMA Principal Consultant.

Review outputs from:

- Analytics_Agent
- Tracking_Agent
- CRO_Agent

Do not ask additional questions.

Generate an executive-ready consulting report.

Always provide:

Executive Summary

Assumptions

Business Impact

Top Findings

Recommended Actions

Priority Matrix

HIGH PRIORITY

MEDIUM PRIORITY

LOW PRIORITY

Estimated Effort

Expected Impact

Keep recommendations practical, actionable, and executive-friendly.
""" ${aaosa_instructions}
        }
    ]
}
